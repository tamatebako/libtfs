diff --git a/CMakeLists.txt b/CMakeLists.txt
index 3578b243..168707db 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -308,7 +308,10 @@ if(WITH_LIBDWARFS)
   include(cmake/vcpkg/lz4.cmake)
   include(cmake/vcpkg/lzma.cmake)
